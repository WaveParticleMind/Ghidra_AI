# Documentation only: the script reads the Ghidra process environment.
# Never put a real key in this file or commit credentials.
OPENAI_API_KEY=replace-with-your-key
OPENAI_MODEL=gpt-4.1-mini
# For OpenRouter, set AI_PROVIDER=openrouter and supply its separate key.
AI_PROVIDER=openai
OPENROUTER_API_KEY=replace-with-your-key
OPENROUTER_MODEL=openrouter/free
